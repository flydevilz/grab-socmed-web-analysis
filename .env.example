# Copy this file to .env and fill in your own keys. NEVER commit .env.
# Apify: https://console.apify.com/settings/integrations
# Either one shared token...
APIFY_TOKEN=
# ...or one per platform (used first if set):
APIFY_TOKEN_REDDIT=
APIFY_TOKEN_TWITTER=
APIFY_TOKEN_THREADS=
# Google PageSpeed Insights API key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
